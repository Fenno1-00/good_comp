{
  "sap.app": {
    "id": "assessmentGapList",
    "type": "card",
    "title": "{{CARD_TITLE}}",
    "subTitle": "{{CARD_SUBTITLE}}",
    "description": "{{CARD_SUBTITLE}}",
    "applicationVersion": {
      "version": "1.0.2"
    },
    "i18n": "i18n/i18n.properties"
  },
  "sap.ui": {
    "technology": "UI5"
  },
  "sap.card": {
    "type": "List",
    "extension": "./GapListExtension",
    "configuration": {
      "destinations": {
        "comp_mat_card": {
          "name": "comp_mat_card",
          "defaultUrl": "https://flexso-consumer-dev.launchpad.cfapps.eu10.hana.ondemand.com/dynamic_dest/comp_mat_card"
        }
      },
      "filters": {
        "roleId": {
          "type": "Select",
          "label": "{{FILTER_ROLE}}",
          "item": {
            "path": "/roles",
            "template": {
              "key": "{externalCode}",
              "title": "{externalName}"
            }
          },
          "data": {
            "request": {
              "url": "{{destinations.comp_mat_card}}/icv/employees/me",
              "headers": {
                "Accept": "application/json"
              }
            }
          }
        }
      }
    },
    "data": {
      "extension": {
        "method": "getData"
      }
    },
    "header": {
      "title": "{{CARD_TITLE}}",
      "subtitle": "{defaultFullName}",
      "status": {
        "text": "{statusText}"
      }
    },
    "content": {
      "data": {
        "path": "/items"
      },
      "item": {
        "title": "{title}",
        "info": {
          "value": "{infoText}"
        }
      }
    }
  }
}