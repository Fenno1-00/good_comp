{
	"sap.app": {
		"id": "competencycards.employeeProfile",
		"type": "card",
		"title": "{{CARD_TITLE}}",
		"subTitle": "{{CARD_SUBTITLE}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"i18n": "i18n/i18n.properties"
	},
	"sap.ui": {
		"technology": "UI5"
	},
	"sap.card": {
		"type": "Object",
		"configuration": {
			"destinations": {
				"comp_mat_card": {
					"name": "comp_mat_card",
					"defaultUrl": "https://flexso-extensions-dev-cmtrx-v3-cmtrx-srv.cfapps.eu10.hana.ondemand.com"
				}
			}
		},
		"data": {
			"request": {
				"url": "{{destinations.comp_mat_card}}/icv/employees/me",
				"method": "GET",
				"headers": {
					"Accept": "application/json"
				}
			}
		},
		"header": {
			"title": "{{CARD_TITLE}}",
			"subtitle": "{{CARD_SUBTITLE}}",
			"icon": {
				"src": "sap-icon://person-placeholder",
				"shape": "Circle"
			},
			"status": {
				"text": "{relationToCurrentUser}"
			}
		},
		"content": {
			"groups": [
				{
					"title": "{{GROUP_PERSONAL}}",
					"items": [
						{
							"label": "{{LABEL_FULLNAME}}",
							"value": "{defaultFullName}"
						},
						{
							"label": "{{LABEL_EMAIL}}",
							"value": "{email}"
						},
						{
							"label": "{{LABEL_USERID}}",
							"value": "{userId}"
						},
						{
							"label": "{{LABEL_COUNTRY}}",
							"value": "{country}"
						}
					]
				},
				{
					"title": "{{GROUP_ORGANISATION}}",
					"items": [
						{
							"label": "{{LABEL_JOBROLE}}",
							"value": "{jobCode}"
						},
						{
							"label": "{{LABEL_DEPARTMENT}}",
							"value": "{department}"
						},
						{
							"label": "{{LABEL_DIVISION}}",
							"value": "{division}"
						},
						{
							"label": "{{LABEL_LOCATION}}",
							"value": "{location}"
						},
						{
							"label": "{{LABEL_FUNCTION}}",
							"value": "{function}"
						}
					]
				},
				{
					"title": "{{GROUP_MANAGER}}",
					"items": [
						{
							"label": "{{LABEL_MANAGER}}",
							"value": "{manager/defaultFullName}"
						},
						{
							"label": "{{LABEL_TEAM_SIZE}}",
							"value": "{teamMembersSize}"
						}
					]
				}
			]
		}
	},
	"sap.ui5": {
		"flexBundle": false
	}
}