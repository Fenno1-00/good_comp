<mvc:View
  displayBlock="true"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc">
  <VBox busy="{view>/busy}" class="sapUiSmallMargin sapUiSmallMarginTopBottom">
    <MessageStrip
      text="{view>/error}"
      type="Error"
      visible="{= !!${view>/error} }"
      class="sapUiTinyMarginBottom" />
    <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap">
      <VBox class="sapUiTinyMarginBottom">
        <Title level="H4" text="{i18n>HEADLINE}" />
        <Text text="{view>/fullName}" visible="{= !!${view>/fullName} }" />
        <Text text="{view>/summaryText}" visible="{= !!${view>/summaryText} }" class="sapUiTinyMarginTop" />
      </VBox>
      <ObjectStatus
        text="{view>/statusText}"
        state="{view>/statusState}"
        inverted="true"
        visible="{= !!${view>/statusText} }" />
    </HBox>
    <HBox wrap="Wrap" class="sapUiMediumMarginTop">
      <VBox width="11rem" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
        <Text text="{i18n>OVERDUE_LABEL}" />
        <ObjectNumber number="{view>/overdueCount}" state="Error" emphasized="true" class="sapUiTinyMarginTop" />
      </VBox>
      <VBox width="11rem" class="sapUiTinyMarginBottom">
        <Text text="{i18n>EXPIRING_LABEL}" />
        <ObjectNumber number="{view>/expiringCount}" state="Warning" emphasized="true" class="sapUiTinyMarginTop" />
      </VBox>
    </HBox>
    <List
      items="{view>/items}"
      noDataText="{i18n>NO_ITEMS}"
      showSeparators="Inner"
      class="sapUiMediumMarginTop">
      <CustomListItem>
        <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
          <VBox class="sapUiTinyMarginBottom">
            <Title level="H6" text="{view>title}" />
            <Text text="{view>subtitle}" visible="{= !!${view>subtitle} }" />
          </VBox>
          <ObjectStatus text="{view>infoText}" state="{view>state}" />
        </HBox>
      </CustomListItem>
    </List>
  </VBox>
</mvc:View>