{
	"sap.app": {
		"id": "competencycards.overdueCertificates",
		"type": "card",
		"title": "{{CARD_TITLE}}",
		"subTitle": "{{CARD_SUBTITLE}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"i18n": "i18n/i18n.properties"
	},
	"sap.ui": {
		"technology": "UI5"
	},
	"sap.card": {
		"type": "Component",
		"configuration": {
			"destinations": {
				"comp_mat_card": {
					"name": "comp_mat_card",
					"defaultUrl": "https://flexso-consumer-dev.launchpad.cfapps.eu10.hana.ondemand.com/dynamic_dest/comp_mat_card"
				}
			}
		},
		"header": {
			"title": "{{CARD_TITLE}}",
			"subTitle": "{{CARD_SUBTITLE}}"
		}
	},
	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.96.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {}
			}
		},
		"rootView": {
			"viewName": "competencycards.overdueCertificates.view.Main",
			"type": "XML",
			"async": true,
			"id": "main"
		},
		"flexBundle": false
	}
