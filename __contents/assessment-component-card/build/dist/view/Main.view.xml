<mvc:View
  controllerName="competencycards.assessmentComponentV2.controller.Main"
  displayBlock="true"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc">
  <VBox busy="{view>/busy}" class="sapUiSmallMargin">
    <VBox visible="{view>/hasRoleFilter}" class="sapUiTinyMarginBottom">
      <Label text="{i18n>ROLE_LABEL}" labelFor="roleSelect" />
      <Select
        id="roleSelect"
        change=".onRoleChange"
        items="{view>/roles}"
        selectedKey="{view>/selectedRoleId}">
        <core:Item key="{view>key}" text="{view>title}" />
      </Select>
    </VBox>
    <Title
      level="H5"
      text="{view>/fullName}"
      visible="{= !!${view>/fullName} }" />
    <MessageStrip
      text="{view>/error}"
      type="Error"
      visible="{= !!${view>/error} }" />
    <HBox
      alignItems="Center"
      justifyContent="SpaceBetween"
      renderType="Bare"
      wrap="Wrap">
      <core:HTML content="{view>/chartMarkup}" sanitizeContent="false" />
      <VBox class="sapUiSmallMarginBegin sapUiTinyMarginTop">
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <core:Icon src="sap-icon://circle-task-2" color="#BB0000" size="0.75rem" class="sapUiTinyMarginEnd" />
          <Label text="{i18n>GAP_LT_MINUS_ONE}" width="8rem" />
          <ObjectNumber number="{view>/gapCounts/lessThanMinusOne}" />
        </HBox>
        <HBox alignItems="Center" class="sapUiTinyMarginBottom">
          <core:Icon src="sap-icon://circle-task-2" color="#E9730C" size="0.75rem" class="sapUiTinyMarginEnd" />
          <Label text="{i18n>GAP_EQ_MINUS_ONE}" width="8rem" />
          <ObjectNumber number="{view>/gapCounts/equalMinusOne}" />
        </HBox>
        <HBox alignItems="Center">
          <core:Icon src="sap-icon://circle-task-2" color="#107E3E" size="0.75rem" class="sapUiTinyMarginEnd" />
          <Label text="{i18n>GAP_GTE_ZERO}" width="8rem" />
          <ObjectNumber number="{view>/gapCounts/greaterOrEqualZero}" />
        </HBox>
      </VBox>
    </HBox>
  </VBox>
</mvc:View>