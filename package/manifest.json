									"title": "{{CARD_TITLE}}",
									"subTitle": "{{CARD_SUBTITLE}}",
									"applicationVersion": {
										"version": "1.0.0"
									},
									"i18n": "i18n/i18n.properties"
								},
								"sap.ui": {
									"technology": "UI5"
								},
								"sap.card": {
									"type": "Table",
									"extension": "./CardExtension",
									"configuration": {
										"destinations": {
											"comp_mat_card": {
												"name": "comp_mat_card",
												"defaultUrl": "https://flexso-consumer-dev.launchpad.cfapps.eu10.hana.ondemand.com/dynamic_dest/comp_mat_card"
											}
										},
										"filters": {
											"roleId": {
												"type": "Select",
												"label": "{{FILTER_ROLE}}",
												"item": {
													"path": "/roles",
													"template": {
														"key": "{externalCode}",
														"title": "{externalName}"
													}
												},
												"data": {
													"request": {
														"url": "{{destinations.comp_mat_card}}/icv/employees/me",
														"headers": {
															"Accept": "application/json"
														}
													}
												}
											}
										}
									},
									"data": {
										"request": {
											"url": "{{destinations.comp_mat_card}}/icv/employees/me",
											"parameters": {
												"targetRoles": "{filters>/roleId/value}"
											},
											"headers": {
												"Accept": "application/json"
											}
										},
										"path": "/"
									},
									"header": {
										"title": "{{CARD_TITLE}}",
										"subtitle": "{defaultFullName}",
										"status": {
											"text": "{statusText}"
										}
									},
									"content": {
										"data": {
											"path": "/assessments"
										},
										"row": {
											"columns": [
												{
													"title": "{{COL_COMPETENCE}}",
													"value": "{competence/externalName}",
													"width": "20%"
												},
												{
													"title": "{{COL_TYPE}}",
													"value": "{status/type}",
													"width": "10%"
												},
												{
													"title": "{{COL_CURRENT_STATUS}}",
													"value": "{status/statusName}",
													"state": "{= ${status/iconColor} === 'red' ? 'Error' : ${status/iconColor} === 'orange' ? 'Warning' : ${status/iconColor} === 'green' ? 'Success' : 'None'}",
													"width": "15%"
												},
												{
													"title": "{{COL_TARGET_STATUS}}",
													"value": "{targetStatus/statusName}",
													"width": "15%"
												},
												{
													"title": "{{COL_VALID_UNTIL}}",
													"value": "{= ${validUntil} ? ${validUntil}.slice(0,10) : '—'}",
													"width": "12%"
												},
												{
													"title": "{{COL_GAP}}",
													"value": "{gap}",
													"state": "{= ${gap} >= 0 ? 'Success' : ${gap} === -1 ? 'Warning' : 'Error'}",
													"width": "8%"
												},
												{
													"title": "{{COL_COMMENT}}",
													"value": "{= ${comment} ? ${comment} : '—'}",
													"width": "20%"
												}
											]
										}
									}
								}
							},
							"vizResources": {
								"artifactId": "assessment-detail"
							}
						}
					}
				},
