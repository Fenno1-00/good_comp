									},
									"header": {
										"title": "{{CARD_TITLE}}",
										"subtitle": "{defaultFullName}"
									},
									"content": {
										"chartType": "Donut",
										"popover": {
											"active": true
										},
										"legend": {
											"visible": true,
											"position": "Right",
											"alignment": "Center"
										},
										"plotArea": {
											"dataLabel": {
												"visible": true,
												"hideWhenOverlap": true
											}
										},
										"chartProperties": {
											"plotArea": {
												"colorPalette": [
													"#107E3E",
													"#E9730C",
													"#BB0000"
												]
											},
											"interaction": {
												"selectability": {
													"mode": "SINGLE"
												}
											}
										},
										"title": {
											"text": "{{CHART_TITLE}}",
											"visible": true,
											"alignment": "Left"
										},
										"data": {
											"path": "/gapSummary"
										},
										"dimensions": [
											{
												"name": "Gap Status",
												"value": "{label}"
											}
										],
										"measures": [
											{
												"name": "Count",
												"value": "{count}"
											}
										],
										"feeds": [
											{
												"uid": "color",
												"type": "Dimension",
												"values": [
													"Gap Status"
												]
											},
											{
												"uid": "size",
												"type": "Measure",
												"values": [
													"Count"
												]
											}
										]
